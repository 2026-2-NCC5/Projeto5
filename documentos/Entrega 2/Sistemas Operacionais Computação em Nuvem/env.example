NODE_ENV=production
APP_VERSION=1.0.0
# "supabase" (produção, padrão) ou "local" (JWT local — SOMENTE para testes de carga/avaliação)
APP_AUTH_PROVIDER=supabase
LOG_LEVEL=info
DB_NAME=alvaro
DB_USER=alvaro
DB_POOL=10
GEMINI_MODEL=gemini-3.5-flash-lite
PUBLIC_HTTPS_PORT=8443
PUBLIC_HTTP_PORT=8080
# Origem pública completa. Em VM: https://seu-dominio.example
PUBLIC_ORIGIN=https://localhost:8443
# Integrações (valores públicos/não-secretos). Segredos ficam em ./secrets
SUPABASE_URL=
SUPABASE_ANON_KEY=
AUTH_REDIRECT_URL=
R2_ACCOUNT_ID=
R2_BUCKET_NAME=alvaro-ai-storage
# Backup
BACKUP_INTERVAL_SECONDS=21600
BACKUP_RETENTION_DAYS=14
