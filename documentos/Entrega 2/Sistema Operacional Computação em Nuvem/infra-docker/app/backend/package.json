{
  "name": "alvaro-ai-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "tsx src/index.ts",
    "seed": "tsx src/seed.ts",
    "db:push": "tsx src/prisma-cli.ts db push",
    "db:generate": "tsx src/prisma-cli.ts generate",
    "db:studio": "tsx src/prisma-cli.ts studio",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "pg": "8.16.3",
    "prom-client": "^15.1.3",
    "tsx": "^4.23.13",
    "unpdf": "^1.4.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.4.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.23.1",
    "prisma": "^6.19.3",
    "typescript": "~6.0.2"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  }
}
