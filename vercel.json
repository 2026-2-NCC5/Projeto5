{
  "buildCommand": "npm --prefix \"src/Entrega 1/Frontend\" run build",
  "outputDirectory": "src/Entrega 1/Frontend/dist",
  "installCommand": "npm --prefix \"src/Entrega 1/Frontend\" install",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://alvaro-ai-backend.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
