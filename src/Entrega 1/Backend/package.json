{
  "name": "alvaro-ai-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "tsx src/index.ts",
    "seed": "tsx src/seed.ts",
    "db:push": "tsx src/prisma-cli.ts db push",
    "db:generate": "tsx src/prisma-cli.ts generate",
    "db:studio": "tsx src/prisma-cli.ts studio",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "6.4.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "pdf-parse": "^2.4.5",
    "prisma": "6.4.1",
    "tsx": "^4.23.13"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.4.0",
    "@types/pdf-parse": "^1.1.5",
    "typescript": "~6.0.2"
  }
}
